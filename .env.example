# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard.
COLLECT_DATA=false          # "true" only once the IRB approves (or for a clearly-labelled class pilot)
COLLECT_AUDIO=false         # also requires the participant's separate audio consent
STUDY_MODE=pilot            # stored on every event: pilot | irb
IRB_PROTOCOL=               # e.g. 12345
DATABASE_URL=               # Postgres connection string (Neon via Vercel Marketplace)
ADMIN_TOKEN=                # long random string (>= 24 chars) for /api/export
